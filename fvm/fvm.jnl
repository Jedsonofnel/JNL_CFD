# JNLisp CFD FVM Package

- Author: Jed Nelson
- Date: 27/11/25

High level FVM interactions for CFD workflows.

j(ns jnl.cfd.fvm
  (:require [jnl.cfd.geometry :as geo]
            [jnl.cfd.linalg :as linalg]))


## Fields

Creates a new namespace
j(defn new-context [mesh]
  {:mesh mesh})

Creates a new field in the context map
j(defn add-field [ctx name init]
  (let [mesh (get ctx :mesh)]
    (assoc ctx name
      (.new-uniform-field init mesh))))

Adds a constant scalar to the context.
j(defn add-constant [ctx name value]
  (assoc ctx name value))

j(defn set-equation-for-field [ctx field eqn]
  (assoc-in ctx [:fields field :equation] eq))



## Equations

Creates a new equation for the entire mesh (all regions).
j(defn new-equation [mesh]
  (.new-equation mesh))

Zeros all coefficients in an equation.
j(defn zero-equation [eq]
  (.equation-zero eq))

Gets diagnostics about the equation as a map
j(defn equation-diagnostics [eq]
  (.equation-diagnostics eq))

## Operators

Adds constant diffusion operator: ∇·(γ∇φ)
Takes field name for gamma from context.
j(defn add-diffusion [eq ctx gamma-field]
  (.flux-constant eq ctx gamma-field))


## Boundary Conditions

Dirichlet BC: fixed value at boundary.
j(defn add-bc-dirichlet [eq ctx boundary-name value]
  (.bc-dirichlet-constant eq ctx boundary-name value))

Neumann BC: fixed gradient at boundary (positive = outward flux).
For insulated/zero-gradient, use value = 0.
j(defn add-bc-neumann [eq ctx boundary-name value]
  (.bc-neumann-constant eq ctx boundary-name value))


## Solving

Solves the equation and updates the field in-place.
j(defn solve [eq solver field]
  (.equation-solve eq solver field))

Retrieves solution vector from equation (for inspection).
j(defn get-solutions [eq]
  (.equation-solutions eq))


## High-Level Workflow Helpers

Assembles and solves a steady diffusion equation.
j(defn solve-diffusion 
  [mesh gamma-val field-init bcs]
  (let [;; Setup context
        ctx (-> (new-context mesh)
                (add-constant :gamma gamma-val)
                (add-field :T field-init))
        ;; Get field reference
        T (get ctx :T)
        ;; Create solver
        solver (linalg/make-simple-solver (geo/ncells mesh) 1000 1e-8)
        ;; Create and assemble equation
        eq (-> (new-equation mesh)
               (zero-equation)
               (add-diffusion ctx :gamma))
        ;; Apply boundary conditions
        eq (reduce (fn [e bc]
                     (case (first bc)
                       :dirichlet (add-bc-dirichlet e ctx (second bc) (nth bc 2))
                       :neumann   (add-bc-neumann e ctx (second bc) (nth bc 2))
                       e))
                   eq
                   bcs)
        ;; Solve
        _ (solve eq solver T)]
    ;; Return context with solution
    (assoc ctx :equation eq :solver solver)))


## Demos and Examples

j(def ^:private test-domain
  (geo/domain
    (geo/rect 0 0 10 1 "solid"
              "left" "right" "top" "bottom")))

j(def ^:private test-mesh
  (geo/triangulate test-domain 
    {:quality 30 :max-area 0.1}))

j(def ^:private test-ctx
  (-> (new-context test-mesh)
      (add-field :T 30)
      (add-field :gamma 2)))

j(def ^:private test-eq
  (new-equation test-mesh))

j(def ^:private test-solver
  (linalg/make-solver (geo/ncells test-mesh) 1000 1e-8))

Simple 1D-like heat conduction test.
Bar with hot left side, cold right side, insulated top/bottom.
j(def ^:private demo-1d-bar
  (let [;; Create thin rectangle (quasi-1D)
        domain (geo/domain 
                 (geo/rect 0 0 10 1 "solid"
                          "bottom" "right" "top" "left"))
        mesh (geo/triangulate domain {:quality 30 :max-area 0.1})
        ;; Boundary conditions
        bcs [[:dirichlet :left 100.0]
             [:dirichlet :right 0.0]
             [:neumann :top 0.0]
             [:neumann :bottom 0.0]]
        ;; Solve
        result (solve-diffusion mesh 1.0 50.0 bcs)]
    result))

Heat conduction with mixed BCs.
j(def ^:private demo-mixed-bc
  (let [domain (geo/domain 
                 (geo/rect 0 0 5 5 "solid" "wall"))
        mesh (geo/triangulate domain {:quality 30 :max-area 0.1})
        ;; One hot wall, rest insulated
        bcs [[:dirichlet :wall 100.0]  ;; Applies to all "wall" boundaries
             [:neumann :wall 0.0]]     ;; This won't override, just for demo
        result (solve-diffusion mesh 1.0 20.0 bcs)]
    result))

Two-sided Dirichlet problem.
j(def ^:private demo-two-sided
  (let [domain (geo/domain
                 (geo/rect 0 0 8 4 "fluid"
                          "cold" "insulated" "hot" "insulated"))
        mesh (geo/triangulate domain {:quality 30 :max-area 0.1})
        bcs [[:dirichlet :hot 100.0]
             [:dirichlet :cold 0.0]
             [:neumann :insulated 0.0]]
        result (solve-diffusion mesh 1.0 50.0 bcs)]
    result))
