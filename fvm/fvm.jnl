# JNLisp CFD FVM Package

- Author: Jed Nelson
- Date: 27/11/25

High level FVM interactions for CFD workflows.

j(ns jnl.cfd.fvm
  (:require [jnl.cfd.geometry :as geo]
            [jnl.cfd.linalg :as linalg]))


## Matrices
j(defn new-equation [mesh]
  (.new-equation  mesh))

j(defn zero-equation [eq]
  (.equation-zero eq))

j(defn solve [eq solver field]
  (.equation-solve eq solver field))

j(defn equation-solutions [eq]
  (.equation-solutions eq))

j(defn equation-diagnostics [eq]
  (.equation-diagnostics))


## Context Structure

Context holds schemas, values and cached compiled equations separately
j(defn new-context [mesh]
  {:mesh mesh
   :values {}
   :equations {} ; Symbolic equation definitions
   :matrices {} ; Field data and constants
   :solvers {}})

j(defn add-field [ctx name init]
  (let [mesh (get ctx :mesh)]
    (assoc-in ctx [:values name]
              (float-tuple (geo/ncells mesh) init))))

j(defn add-constant [ctx name value]
  (assoc-in ctx [:values name] value))

j(defn get-field [ctx name]
  (get-in ctx [:values name]))


## Equation Definition

Define equation schema for a field
j(defn define-equation [ctx field-name schema]
  (assoc-in ctx [:equations field-name] schema))

j(defn equation []
  {:operators []
   :sources []
   :bcs []})

j(defn with-laplacian [eqn coefficient]
  (update eqn :operators conj [:laplacian coefficient]))

j(defn with-source-const [eqn value]
  (update eqn :sources conj [:const value]))

j(defn with-bc-dirichlet [eqn boundary value]
  (update eqn :bcs conj [:dirichlet boundary value]))

j(defn with-bc-neumann [eqn boundary value]
  (update eqn :bcs conj [:neumann boundary value]))

j(defn with-bc-robin [eqn boundary h t-inf]
  (update eqn :bcs conj [:robin boundary h t-inf]))


### Internal Matrix Management

j(defn- ensure-matrix [ctx field-name]
  (if (get-in ctx [:matrices field-name])
      ctx
      (let [mesh (get ctx :mesh)
            matrix (.new-equation mesh)]
        (assoc-in ctx [:matrices field-name] matrix))))

j(defn- ensure-solver [ctx field-name solver-spec]
  (if (get-in ctx [:solvers field-name])
      ctx
      (assoc-in ctx [:solvers field-name] solver-spec)))


### Equation Solving

j(defn- apply-operator! [matrix ctx op]
  (let [[op-type & args] op]
    (case op-type
      :laplacian 
        (let [[coefficient] args]
          (.laplacian-constant matrix ctx coefficient)))))

j(defn- apply-source! [matrix ctx src]
  (let [[src-type & args] src]
    (case src-type
      :const
        (let [[value] args]
          (.source-constant matrix value)))))

j(defn- apply-bc! [matrix ctx bc]
  (let [[bc-type boundary & args] bc]
    (case bc-type
      :dirichlet 
        (let [[value] args]
          (.bc-dirichlet-constant matrix ctx boundary value))
      :neumann 
        (let [[value] args]
          (.bc-neumann-constant matrix ctx boundary value))
      :robin
        (let [[h t-inf] args]
          (.bc-robin-constant matrix ctx boundary h t-inf)))))

Builds the matrix according to the equation
j(defn- build-matrix! [matrix ctx eqn]
  (.equation-zero matrix)
  (doseq [op (get eqn :operators)]
    (apply-operator! matrix ctx op))
  (doseq [src (get eqn :sources)]
    (apply-source! matrix ctx src))
  (doseq [bc (get eqn :bcs)]
    (apply-bc! matrix ctx bc)))

j(defn solve-equation
  ([ctx field-name]
    (solve-equation ctx field-name nil))
  ([ctx field-name solver]
    (let [solver (or solver
                     (let [ncells (geo/ncells (get ctx :mesh))]
                          (linalg/make-cg-simple-solver ncells 1000 1e-6)))
          ctx (-> ctx
                  (ensure-matrix field-name)
                  (ensure-solver field-name solver))
          matrix (get-in ctx [:matrices field-name])
          eqn (get-in ctx [:equations field-name])
          solver-obj (get-in ctx [:solvers field-name])
          field (get-in ctx [:values field-name])]
      (build-matrix! matrix ctx eqn)
      (.equation-solve matrix solver-obj field)
      ctx)))


## Demos and Examples


### Simple Solvers

Simple 1D-like heat diffusion in a channel with hot inlet, cold outlet
j(defn demo-1D-heat-diffusion []
  (-> (new-context geo/demo-channel-mesh)
      (add-field :T 293.0)
      (add-constant :gamma 100.0)
      (define-equation :T
        (-> (equation)
            (with-laplacian :gamma)
            (with-bc-dirichlet "inlet" 400.0)
            (with-bc-dirichlet "outlet" 300.0)
            (with-bc-neumann "wall" 0.0)))
      (solve-equation :T)))
