# JNLisp CFD FVM Package

- Author: Jed Nelson
- Date: 27/11/25

High level FVM interactions for CFD workflows.

j(ns jnl.cfd.fvm
  (:require [jnl.cfd.geometry :as geo]
            [jnl.cfd.linalg :as linalg]))


## Linear Systems (matrix + rhs)

j(defn system-diagnostics [eq]
  (.sys-diagnostics))


## Context Structure

Context holds schemas, values and cached compiled equations separately
j(defn new-context [mesh]
  {:mesh mesh
   :values {}
   :equations {} ; Symbolic equation definitions
   :matrices {} ; Field data and constants
   :solvers {}})

j(defn add-field [ctx name init]
  (let [mesh (get ctx :mesh)]
    (assoc-in ctx [:values name]
              (float-tuple (geo/ncells mesh) init))))

j(defn add-constant [ctx name value]
  (assoc-in ctx [:values name] value))

j(defn get-field [ctx name]
  (get-in ctx [:values name]))


## Equation Definition

Define equation schema for a field
j(defn define-equation [ctx field-name schema]
  (assoc-in ctx [:equations field-name] schema))

j(defn equation []
  {:operators []
   :sources []
   :bcs []})


### Operators

j(defn with-laplacian 
  ([eqn coefficient] 
    (update eqn :operators conj [:laplacian coefficient]))
  ([eqn coefficient & regions]
    (update eqn :operators conj (into [:laplacian coefficient] regions))))

j(defn with-source-const
  ([eqn value]
    (update eqn :sources conj [:const value]))
  ([eqn value & regions]
    (update eqn :sources conj (into [:const value] regions))))


### Boundary Conditions

j(defn with-bc-dirichlet [eqn boundary value]
  (update eqn :bcs conj [:dirichlet boundary value]))

j(defn with-bc-neumann [eqn boundary value]
  (update eqn :bcs conj [:neumann boundary value]))

j(defn with-bc-robin [eqn boundary h t-inf]
  (update eqn :bcs conj [:robin boundary h t-inf]))


### Internal Matrix Management

j(defn- ensure-matrix [ctx field-name]
  (if (get-in ctx [:matrices field-name])
      ctx
      (let [mesh (get ctx :mesh)
            matrix (.new-linear-system mesh)]
        (assoc-in ctx [:matrices field-name] matrix))))

j(defn- ensure-solver [ctx field-name solver-spec]
  (if (get-in ctx [:solvers field-name])
      ctx
      (assoc-in ctx [:solvers field-name] solver-spec)))


### Equation Solving

j(defn- apply-operator! [matrix ctx op]
  (let [[op-type & args] op]
    (case op-type
      :laplacian 
        (let [[coeff & regions] args]
          (apply .laplacian-constant matrix ctx coeff regions)))))

j(defn- apply-source! [matrix ctx src]
  (let [[src-type & args] src]
    (case src-type
      :const
        (let [[value & regions] args]
          (apply .source-constant matrix ctx value regions)))))

j(defn- apply-bc! [matrix ctx bc]
  (let [[bc-type boundary & args] bc
        bname (keyword boundary)]
    (case bc-type
      :dirichlet 
        (let [[value] args]
          (.bc-dirichlet-constant matrix ctx bname value))
      :neumann 
        (let [[value] args]
          (.bc-neumann-constant matrix ctx bname value))
      :robin
        (let [[h t-inf] args]
          (.bc-robin-constant matrix ctx bname h t-inf)))))

Builds the matrix according to the equation
j(defn- build-matrix! [matrix ctx eqn]
  (.sys-zero matrix)
  (doseq [op (get eqn :operators)]
    (apply-operator! matrix ctx op))
  (doseq [src (get eqn :sources)]
    (apply-source! matrix ctx src))
  (doseq [bc (get eqn :bcs)]
    (apply-bc! matrix ctx bc)))

j(defn solve-equation
  ([ctx field-name]
    (solve-equation ctx field-name nil))
  ([ctx field-name solver]
    (let [solver (or solver
                     (let [ncells (geo/ncells (get ctx :mesh))]
                          (linalg/make-cg-simple-solver ncells 1000 1e-6)))
          ctx (-> ctx
                  (ensure-matrix field-name)
                  (ensure-solver field-name solver))
          matrix (get-in ctx [:matrices field-name])
          eqn (get-in ctx [:equations field-name])
          solver-obj (get-in ctx [:solvers field-name])
          field (get-in ctx [:values field-name])]
      (build-matrix! matrix ctx eqn)
      (.sys-solve matrix solver-obj field)
      ctx)))


## Visualisation

Prepare field data for WebGL rendering
j(defn prepare-field-viz [ctx field-name]
  (let [mesh (get ctx :mesh)
        field (get-field ctx field-name)
        tri-data (geo/triangulate-mesh mesh)
        vertices (get tri-data :vertices)
        tri-to-cells (get tri-data :tri-to-cells)
        normalized (.update-tri-field field tri-to-cells)]
    {:type :field-viz
     :field field-name
     :vertices vertices
     :values normalized
     :mesh (hash-map mesh)}))


## Demos and Examples


### Simple Solvers

Simple 1D-like heat diffusion in a channel with hot inlet, cold outlet
j(defn demo-1D-heat-diffusion []
  (-> (new-context geo/demo-channel-mesh)
      (add-field :T 293.0)
      (add-constant :gamma 100.0)
      (define-equation :T
        (-> (equation)
            (with-laplacian :gamma)
            (with-bc-dirichlet "inlet" 400.0)
            (with-bc-dirichlet "outlet" 300.0)
            (with-bc-neumann "wall" 0.0)))
      (solve-equation :T)))


### Parametric Solvers

PCB thermal with chip heat sources - generates geometry on the fly
j(defn demo-chip-array 
  ([] 
    (demo-chip-array 0.01 3 2 293.0 10.0))
  ([spacing num-x num-y] 
    (demo-chip-array spacing num-x num-y 293.0 10.0))
  ([spacing num-x num-y t-ambient h]
    (let [; Generate PCB geometry
          chip-w 0.05
          chip-h 0.04
          domain (geo/demo-pcb-generator spacing num-x num-y chip-w chip-h)
          mesh (geo/triangulate domain {:quality 25 :max-area 0.000005})]
      (-> (new-context mesh)
          (add-field :T t-ambient)
          (add-constant :k-pcb 0.3)      ; W/(m·K) - FR4
          (add-constant :k-chip 150.0)   ; W/(m·K) - Silicon
          (add-constant :q-chip 5e6)     ; W/m³ - volumetric heat gen
          (add-constant :h h)            ; W/(m²·K) - convection coeff (for later)
          (define-equation :T
            (-> (equation)
                ; Diffusion with same k everywehere
                (with-laplacian :k-pcb)
                ; Heat generation only in chip region
                (with-source-const 5e6 :chip)
                ; Simple Dirichlet BC at ambient on perimeter
                (with-bc-dirichlet "ambient" t-ambient)))
          (solve-equation :T)))))
