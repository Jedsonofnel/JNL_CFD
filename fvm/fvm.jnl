# JNLisp CFD FVM Package

- Author: Jed Nelson
- Date: 27/11/25

High level FVM interactions for CFD workflows.

j(ns jnl.cfd.fvm
  (:require [jnl.cfd.geometry :as geo]
            [jnl.cfd.linalg :as linalg]))


## Equations

j(defn new-equation [mesh]
  (.new-equation  mesh))

j(defn zero-equation [eq]
  (.equation-zero eq))

j(defn solve [eq solver field]
  (.equation-solve eq solver field))

j(defn equation-solutions [eq]
  (.equation-solutions eq))

j(defn equation-diagnostics [eq]
  (.equation-diagnostics))


## Context Structure

Context holds schemas, values and cached compiled equations separately
j(defn new-context [mesh]
  {:mesh mesh
   :schemas {} ; Symbolic equation definitions
   :values {} ; Field data and constants
   :equations {}})

j(defn add-field [ctx name init]
  (let [mesh (get ctx :mesh)]
    (assoc-in ctx [:values name]
                  (float-tuple (geo/ncells mesh) init))))

j(defn add-constant [ctx name value]
  (assoc-in ctx [:values name] value))


## Equation Schema Definition

Define equation schema for a field
j(defn define-equation [ctx field-name schema]
  (assoc-in ctx [:schemas field-name] schema))

j(defn equation-schema []
  {:operators []
   :sources []
   :bcs []})

j(defn with-laplacian [schema diffusivity-field]
  (update schema :operators conj [:laplacian diffusivity-field]))

j(defn with-bc [schema bc-type boundary-name value]
  (update schema :bcs conj {:type bc-type
                            :boundary boundary-name
                            :value value}))


## Equation Compilation

j(defn ^:private apply-operator! [eq ctx op]
  (let [[op-type & args] op]
    (case op-type
      :laplacian (let [[diff-field] args
                       gamma (get-in ctx [:values diff-field])]
                  (.flux-constant eq ctx diff-field))
      )))

j(defn ^:private apply-bc! [eq ctx bc-spec]
  (case (get bc-spec :type)
    :dirichlet (.bc-dirichlet-constant eq ctx 
                                       (get bc-spec :boundary)
                                       (get bc-spec :value))
    :neumann (.bc-neumann-constant eq ctx
                                   (get bc-spec :boundary)
                                   (get bc-spec :value))))

Compiles schema into equation object and caches it
j(defn compile-equation! [ctx field-name]
  (let [schema (get-in ctx [:schemas field-name])
        mesh (get ctx :mesh)
        eq (new-equation mesh)]
    ; Apply all operators
    (doseq [op (get schema :operators)]
      (apply-operator! eq ctx op))
    ; Apply all sources
    (doseq [src (get schema :sources)]
      (apply-operator! eq ctx src))
    ; Apply all BCs
    (doseq [bc (get schema :bcs)]
      (apply-bc! eq ctx bc))
    ; Cache compiled equation
    (assoc-in ctx [:equations field-name] eq)))



## Solving

Solve field using cached or freshly compiled equation
j(defn solve-field [ctx field-name solver]
  (let [; Compile if not cached
        ctx (if (get-in ctx [:equations field-name])
                ctx
                (compile-equation! ctx field-name))
        eq (get-in ctx [:equations field-name])
        field (get-in ctx [:values field-name])]
    (solve eq solver field)
    ctx))
