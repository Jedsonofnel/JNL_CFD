# JNLisp CFD Geometry Package

- Author: Jed Nelson
- Date: 27/11/25

High level geometry and domain construction for CFD workflows.

j(ns jnl.cfd.geometry)


## Meshing

Meshes the domain with Triangle.c according to the option string passed.
j(defn triangulate 
  ([domain] (triangulate domain {}))
  ([domain opts]
    (let [quality (get opts :quality 20)
          max-area (get opts :max-area 0)]
      (.triangulate domain quality max-area))))

Returns the number of cells in a given mesh.
j(defn ncells [mesh]
  (.mesh-ncells mesh))

Returns the number of vertices in a given mesh.
j(defn nverts [mesh]
  (.mesh-nverts mesh))

Returns a map of the region name mapping for a mesh.
j(defn region-names [mesh]
  (.mesh-region-names mesh))

Returns a map of the boundary name mapping for a mesh.
j(defn boundary-names [mesh]
  (.mesh-boundary-names mesh))


## Polygon constructors

Rectangle with sane defaults - single boundary name applies to all edges.
j(defn rect
  ([x y w h] (rect x y w h ""))
  ([x y w h region] (rect x y w h region ""))
  ([x y w h region boundary]
    (.make-rectangle (float x) (float y) (float w) (float h) region boundary))
  ([x y w h region bottom right top left]
    (.make-rectangle (float x) (float y) (float w) (float h) 
                     region bottom right top left)))

Circle with reasonable discretization default.
j(defn circle
  ([cx cy r] (circle cx cy r ""))
  ([cx cy r region] (circle cx cy r region ""))
  ([cx cy r region boundary] (circle cx cy r region boundary 64))
  ([cx cy r region boundary n-sides]
    (.make-circle (float cx) (float cy) (float r) n-sides region boundary)))

General polygon from point pairs [x0 y0 x1 y1 ...].
j(defn poly
  ([points region] (poly points region ""))
  ([points region boundary]
    (.make-polygon points region boundary)))


## Domain builder operations

Creates a new empty domain builder.
j(defn domain-builder []
  (.make-domain-builder))

Adds a polygon to the domain.
j(defn add-poly [builder polygon]
  (.domain-builder-add-polygon builder polygon))

Adds a polygon as a hole (reverses winding automatically).
j(defn add-hole [builder polygon]
  (.domain-builder-add-hole builder polygon))

Builds the final domain from accumulated polygons.
j(defn build-domain [builder]
  (.domain-builder-build builder))


## Domain construction macro

Builds a domain from a series of polygon expressions.
j(defmacro domain [& shapes]
  (let [builder-sym (gensym)]
    `(let [~builder-sym (jnl.cfd.geometry/domain-builder)]
       ~@(map (fn [shape]
                (if (and (list? shape) 
                         (= 'hole (first shape)))
                    `(jnl.cfd.geometry/add-hole ~builder-sym ~(second shape))
                    `(jnl.cfd.geometry/add-poly ~builder-sym ~shape)))
              shapes)
       (jnl.cfd.geometry/build-domain ~builder-sym))))


## Domain queries

Returns domain bounds as [minx miny maxx maxy].
j(defn domain-bounds [d]
  (.domain-bounds d))


## Polygon queries

Returns polygon area.
j(defn poly-area [p]
  (.polygon-area p))

Returns polygon bounds as [minx miny maxx maxy].
j(defn poly-bounds [p]
  (.polygon-bounds p))

Tests if polygon contains point (x, y).
j(defn poly-contains? [p x y]
  (.polygon-contains p (float x) (float y)))


## Demos and Examples


### Basic Shapes

j(def ^:private demo-rectangle
  (rect 0 0 100 50 "fluid" "wall"))

j(def ^:private demo-circle
  (circle 50 50 25 "solid" "surface" 32))

j(def ^:private demo-triangle
  (poly [0.0 0.0  100.0 0.0  50.0 86.6]
        "fluid" "wall"))

j(def ^:private demo-hexagon
  (poly [50.0 0.0   93.3 25.0   93.3 75.0  
         50.0 100.0  6.7 75.0    6.7 25.0]
        "solid" "boundary"))


### Simple Domains

Single rectangle with all boundaries named
j(def ^:private demo-channel
  (domain
    (rect 0 0 200 50 "fluid" 
          "inlet" "wall" "outlet" "wall")))

Circle in a box (annular flow)
j(def ^:private demo-annular
  (domain
    (rect 0 0 100 100 "fluid" "wall")
    (hole (circle 50 50 20 "void"))))

Two regions with interface
j(def ^:private demo-two-region
  (domain
    (rect 0 0 100 50 "fluid" "inlet" "interface" "outlet" "wall")
    (rect 0 50 100 50 "solid" "wall" "wall" "wall" "interface")))


### Complex Domains

PCB with multiple chips
j(def ^:private demo-pcb
  (domain
    ; Main PCB
    (rect 0 0 120 80 "pcb" "ambient")
    ; Chips
    (rect 20 20 25 15 "chip-1" "chip-surface")
    (rect 55 20 25 15 "chip-2" "chip-surface")
    (rect 90 20 25 15 "chip-3" "chip-surface")
    (rect 20 50 25 15 "chip-4" "chip-surface")
    (rect 55 50 25 15 "chip-5" "chip-surface")
    (rect 90 50 25 15 "chip-6" "chip-surface")))

Heat exchanger with circular holes
j(def ^:private demo-heat-exchanger
  (domain
    (rect 0 0 200 100 "fluid" "inlet" "wall" "outlet" "wall")
    (hole (circle 50 50 8 "tube-1"))
    (hole (circle 100 50 8 "tube-2"))
    (hole (circle 150 50 8 "tube-3"))))

Multi-layer with complex hole
j(def ^:private demo-nested
  (domain
    (rect 0 0 100 100 "outer" "wall")
    (rect 20 20 60 60 "middle" "")
    (hole (rect 35 35 30 30 "void" ""))))

Pipe junction (T-junction)
j(def ^:private demo-t-junction
  (domain
    ; Main horizontal pipe
    (rect 0 40 200 20 "fluid" "inlet" "wall" "outlet" "wall")
    ; Vertical branch
    (rect 90 0 20 100 "fluid" "wall" "branch" "wall" "")))

Thermal domain with circular components
(def ^:private demo-thermal
  (domain
    ; Substrate
    (rect 0 0 150 100 "substrate" "ambient")
    ; Hot spot (polygon)
    (poly [50.0 30.0  70.0 30.0  80.0 50.0  
           70.0 70.0  50.0 70.0  40.0 50.0]
          "hotspot" "heat-source")
    ; Circular heat sink
    (circle 100 50 25 "heatsink" "convection" 48)))

Microfluidic mixer
j(def ^:private demo-microfluidic
  (domain
    ; Inlet channels
    (rect 0 10 50 5 "fluid" "inlet-1" "" "" "")
    (rect 0 35 50 5 "fluid" "inlet-2" "" "" "")
    ; Mixing chamber
    (circle 75 25 20 "fluid" "" 64)
    ; Outlet
    (rect 95 22.5 50 5 "fluid" "" "" "outlet" "")))


### Demo with all features

(def ^:private demo-comprehensive
  (domain
    ; Outer boundary with all edges named differently
    (rect 0 0 200 150 "main-region" 
          "bottom-wall" "right-wall" "top-wall" "left-wall")
    ; Multiple solid obstacles
    (rect 40 40 30 30 "obstacle-1" "obs-surface")
    (rect 120 40 30 30 "obstacle-2" "obs-surface")
    ; Circular feature
    (circle 100 75 15 "circular-region" "circle-boundary" 36)
    ; Holes
    (hole (circle 60 100 8 "void-1"))
    (hole (rect 140 100 15 15 "void-2" ""))
    ; Irregular polygon
    (poly [30.0 110.0  50.0 100.0  60.0 120.0  45.0 140.0  25.0 130.0]
          "irregular" "irregular-boundary")))
