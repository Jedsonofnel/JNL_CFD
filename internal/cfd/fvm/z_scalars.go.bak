uackage fvm

import (
	"fmt"
	"github.com/Jedsonofnel/jnlcfd/internal/cfd/geometry"
	"github.com/Jedsonofnel/jnlcfd/internal/cfd/linalg"
	"math"
	"strings"
)

// RESOLVED STRUCTS

type ScalarPrognostic struct {
	name string
	mesh *geometry.Mesh
	bcs  []*scalarBC
	dt   float32

	cellValues  []float32
	cellValues0 []float32

	fluxOps []*scalarFluxOperator
	srcOps  []struct{}

	sys *systemAssemblyContext
}

func (s *ScalarPrognostic) AdvanceTime(dt float32) {
	s.dt = dt
	copy(s.cellValues0, s.cellValues)
	s.reassembleInternalMatrix()
}

func (sp *ScalarPrognostic) AssembleSystem() *linalg.System {
	sp.sys.PartialWipe()
	sp.sys.SyncDecoratedMatrix()

	// TODO: go through source operators to decorate RHS/MATRIX
	for _, bc := range sp.bcs {
		applyScalarBC(bc, sp, sp.sys)
	}

	return &linalg.System{
		A: sp.sys.Matrix, B: sp.sys.RHS,
	}
}

func (sp *ScalarPrognostic) reassembleInternalMatrix() {
	sp.sys.FullWipe()

	for _, op := range sp.fluxOps {
		applyFluxes(op, sp.mesh, sp.sys)
	}
}

func (sp *ScalarPrognostic) GetValues() []float32 {
	return sp.cellValues
}

func (sp *ScalarPrognostic) SetValues(newValues []float32) {
	copy(sp.cellValues, newValues)
}

// DEFINITIONS

type ScalarPrognosticDefinition struct {
	Name         string
	initialValue float32
	bcs          map[string]ScalarBCDefinition
	operators    []*scalarLaplacianDefinition
	future       *ScalarPrognostic
}

func NewScalarPrognosticDefinition(name string, initialValue float32,
) *ScalarPrognosticDefinition {
	return &ScalarPrognosticDefinition{
		Name:         name,
		initialValue: initialValue,
	}
}

func (spd *ScalarPrognosticDefinition) Validate() error {
	if len(spd.bcs) == 0 {
		return fmt.Errorf("ScalarPrognosticDefinition (%s) > Missing BCs", spd.Name)
	}

	return nil
}

func (spd *ScalarPrognosticDefinition) follow() *ScalarPrognostic {
	if spd.future == nil {
		spd.future = &ScalarPrognostic{}
	}

	return spd.future
}

func (spd *ScalarPrognosticDefinition) SetEquation(ops ...*scalarLaplacianDefinition) error {
	spd.operators = ops
	return nil
}

func (spd *ScalarPrognosticDefinition) SetBoundaryConditions(
	md geometry.MeshDefinition, bcs map[string]ScalarBCDefinition) error {
	spd.bcs = make(map[string]ScalarBCDefinition)

	requiredBoundaries := make(map[string]bool)
	for _, name := range md.GetBoundaries() {
		requiredBoundaries[name] = true
	}

	var missingBoundaries, unknownBoundaries []string

	for name, bc := range bcs {
		if !requiredBoundaries[name] {
			unknownBoundaries = append(unknownBoundaries, name)
		} else {
			spd.bcs[name] = bc
			delete(requiredBoundaries, name)
		}
	}

	for name := range requiredBoundaries {
		missingBoundaries = append(missingBoundaries, name)
	}

	var errParts []string
	if len(missingBoundaries) > 0 {
		errParts = append(errParts, fmt.Sprintf("Missing boundaries: %v", missingBoundaries))
	}
	if len(unknownBoundaries) > 0 {
		errParts = append(errParts, fmt.Sprintf("Unknown boundaries: %v", unknownBoundaries))
	}

	if len(errParts) > 0 {
		return fmt.Errorf("ScalarPrognosticDefinition (%s) > %s", spd.Name, strings.Join(errParts, ";"))
	}

	return nil
}

func (spd *ScalarPrognosticDefinition) Resolve(mesh *geometry.Mesh) (*ScalarPrognostic, error) {
	if err := spd.Validate(); err != nil {
		return &ScalarPrognostic{}, fmt.Errorf("ScalarPrognosticDefinition (%s): Resolve > %w",
			spd.Name, err)
	}

	spd.future = &ScalarPrognostic{
		name: spd.Name,
		mesh: mesh,
		dt:   math.MaxFloat32,
	}

	spd.future.cellValues = make([]float32, mesh.NumCells())
	spd.future.cellValues0 = make([]float32, mesh.NumCells())

	for i := range spd.future.cellValues {
		spd.future.cellValues[i] = spd.initialValue
		spd.future.cellValues0[i] = spd.initialValue
	}

	// resolve boundary conditions
	spd.future.bcs = make([]*scalarBC, len(spd.bcs))

	for i, name := range mesh.Boundaries {
		bc := spd.bcs[name].Resolve(mesh, name)
		spd.future.bcs[i] = bc
	}

	spd.future.fluxOps = make([]*scalarFluxOperator, 0)
	for _, op := range spd.operators {
		spd.future.fluxOps = append(spd.future.fluxOps, op.Resolve(mesh))
	}

	spd.future.sys = newSystemAssemblyContext(
		mesh.NumCells(), mesh.NumBoundaries(), mesh.FaceStarts, mesh.NeighbourIndices,
	)

	return spd.future, nil
}
